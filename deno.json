{
  "tasks": {
    "check": "deno check scripts/*.ts",
    "test:frontend": "deno run --allow-run=npm --allow-env=PATH,HOME,HTTP_PROXY,HTTPS_PROXY,NO_PROXY,http_proxy,https_proxy,no_proxy scripts/ci.ts",
    "lock:nix": "deno run --allow-run=prefetch-npm-deps --allow-write=nix/generated-npm-hash.json scripts/update-npm-hash.ts"
  }
}
